# ─── Postgres ───────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=reventa
POSTGRES_USER=reventa_user
POSTGRES_PASSWORD=changeme

# Built from the vars above — keep in sync if you change user/pass/db
DATABASE_URL=postgresql+asyncpg://reventa_user:changeme@db:5432/reventa

# ─── Backend ────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=changeme-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development

# ─── Super Admin (seeded on first deploy) ───────────────────
ADMIN_EMAIL=admin@reventa.com
ADMIN_PASSWORD=changeme-strong-password
ADMIN_NAME=Super Admin

# ─── AWS / S3 ───────────────────────────────────────────────
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
S3_BUCKET=reventa-vehicles
# LocalStack for local dev — remove in production
S3_ENDPOINT_URL=http://localstack:4566

# ─── Agente WhatsApp ────────────────────────────────────────
AGENT_PORT=8100
# Shared secret between backend and agent — generate a long random string
AGENT_SERVICE_KEY=changeme-agent-service-key
AGENT_BASE_URL=http://agent:8100
REVENTA_API_URL=http://backend:8000/api/v1
REDIS_URL=redis://redis:6379/0

# WhatsApp Cloud API (Meta)
META_APP_SECRET=
META_VERIFY_TOKEN=changeme-webhook-verify-token
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
# Number shown to users when they link their phone, e.g. +54 9 341 000-0000
META_DISPLAY_NUMBER=

# Public app URL — used to send back a link to what the agent just created
APP_PUBLIC_URL=http://localhost:5173

# Notificaciones proactivas — vacío = el agente nunca inicia una conversación.
# Cada mensaje iniciado por el negocio se cobra y necesita un template aprobado por
# Meta con el MISMO nombre. Habilitá de a uno: nueva_oferta,oferta_aceptada,nueva_pretoma
# Ojo con nueva_pretoma: le pega a TODA la red en cada publicación.
ENABLED_NOTIFICATIONS=
WHATSAPP_TEMPLATE_LANGUAGE=es_AR

# Anthropic
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5

# ─── CORS — comma-separated list of allowed frontend origins ─
CORS_ORIGINS=http://localhost:5173

# ─── Frontend ───────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1
